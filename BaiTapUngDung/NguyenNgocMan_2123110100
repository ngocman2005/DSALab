#include <iostream>
#include <conio.h>
#include <windows.h>
#include <cstdlib>
using namespace std;

// ================= GAME DATA =================
bool gameOver;
int width, height;

int x, y, foodX, foodY, score;
int nTail;
int tailX[100], tailY[100];

int speed;

enum eDirection { STOP = 0, LEFT, RIGHT, UP, DOWN };
eDirection dir;

// ================= UI =================
void HideCursor() {
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    CONSOLE_CURSOR_INFO info;
    info.bVisible = FALSE;
    info.dwSize = 100;
    SetConsoleCursorInfo(h, &info);
}

void gotoXY(int x, int y) {
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);
    COORD pos = { (SHORT)x, (SHORT)y };
    SetConsoleCursorPosition(h, pos);
}

// ================= MAP WALL =================
bool isWall(int x, int y, int level) {

    // LEVEL 1: trống
    if (level == 1) return false;

    // LEVEL 2: tường giữa
    if (level == 2) {
        if (y == height / 2 && x > 5 && x < width - 5)
            return true;
    }

    // LEVEL 3: MÊ CUNG FIX (có cửa mở)
    if (level == 3) {

        // tường dọc trái (có lỗ)
        if (x == 5 && !(y >= 8 && y <= 10))
            return true;

        // tường dọc phải (có lỗ)
        if (x == width - 6 && !(y >= 8 && y <= 10))
            return true;

        // tường ngang trên (có cửa)
        if (y == 3 && !(x >= 10 && x <= 15))
            return true;

        // tường ngang dưới (có cửa)
        if (y == height - 4 && !(x >= 5 && x <= 10))
            return true;
    }

    return false;
}

// ================= SAFE FOOD =================
void spawnFood(int level) {
    do {
        foodX = rand() % width;
        foodY = rand() % height;
    } while (isWall(foodX, foodY, level));
}

// ================= INIT =================
void Setup(int level) {
    gameOver = false;
    dir = STOP;
    score = 0;
    nTail = 0;

    if (level == 1) {
        width = 20; height = 20;
        speed = 120;
    }
    else if (level == 2) {
        width = 25; height = 20;
        speed = 90;
    }
    else {
        width = 30; height = 20;
        speed = 60;
    }

    // safe spawn snake
    do {
        x = width / 2;
        y = height / 2;
    } while (isWall(x, y, level));

    spawnFood(level);
}

// ================= DRAW =================
void Draw(int level) {
    gotoXY(0, 0);

    for (int i = 0; i < width + 2; i++) cout << "#";
    cout << "\n";

    for (int i = 0; i < height; i++) {
        for (int j = 0; j < width; j++) {

            if (j == 0) cout << "#";

            if (i == y && j == x)
                cout << "O";
            else if (i == foodY && j == foodX)
                cout << "F";
            else {
                bool print = false;

                // snake body
                for (int k = 0; k < nTail; k++) {
                    if (tailX[k] == j && tailY[k] == i) {
                        cout << "o";
                        print = true;
                    }
                }

                // wall
                if (!print && isWall(j, i, level)) {
                    cout << "#";
                    print = true;
                }

                if (!print) cout << " ";
            }

            if (j == width - 1) cout << "#";
        }
        cout << "\n";
    }

    for (int i = 0; i < width + 2; i++) cout << "#";

    cout << "\nScore: " << score;
    cout << " | Level: " << level << "\n";
}

// ================= INPUT =================
void Input() {
    if (_kbhit()) {
        switch (_getch()) {
        case 'a': dir = LEFT; break;
        case 'd': dir = RIGHT; break;
        case 'w': dir = UP; break;
        case 's': dir = DOWN; break;
        case 'x': gameOver = true; break;
        }
    }
}

// ================= LOGIC =================
void Logic(int level) {

    int prevX = tailX[0];
    int prevY = tailY[0];
    int prev2X, prev2Y;

    tailX[0] = x;
    tailY[0] = y;

    for (int i = 1; i < nTail; i++) {
        prev2X = tailX[i];
        prev2Y = tailY[i];
        tailX[i] = prevX;
        tailY[i] = prevY;
        prevX = prev2X;
        prevY = prev2Y;
    }

    switch (dir) {
    case LEFT: x--; break;
    case RIGHT: x++; break;
    case UP: y--; break;
    case DOWN: y++; break;
    }

    // LEVEL 1 xuyên tường
    if (level == 1) {
        if (x >= width) x = 0;
        else if (x < 0) x = width - 1;

        if (y >= height) y = 0;
        else if (y < 0) y = height - 1;
    }
    else {
        if (x < 0 || x >= width || y < 0 || y >= height)
            gameOver = true;
    }

    // đụng tường
    if (isWall(x, y, level))
        gameOver = true;

    // đụng thân
    for (int i = 0; i < nTail; i++) {
        if (tailX[i] == x && tailY[i] == y)
            gameOver = true;
    }

    // ăn food
    if (x == foodX && y == foodY) {
        score += 10;
        nTail++;
        spawnFood(level);
    }
}

// ================= MENU =================
void menu() {
    system("cls");
    cout << "====================\n";
    cout << "   SNAKE GAME PRO   \n";
    cout << "====================\n";
    cout << "1. Level 1 (Easy)\n";
    cout << "2. Level 2 (Wall)\n";
    cout << "3. Level 3 (Maze FIX)\n";
    cout << "0. Exit\n";
    cout << "Choose: ";
}

// ================= MAIN =================
int main() {
    HideCursor();

    while (true) {
        menu();

        int choice;
        cin >> choice;

        if (choice == 0) break;

        Setup(choice);

        while (!gameOver) {
            Draw(choice);
            Input();
            Logic(choice);
            Sleep(speed);
        }

        cout << "\nGAME OVER! Score: " << score << "\n";
        system("pause");
    }

    return 0;
}
